#pragma once
// Agora RTC + Conversational AI Agent credentials
// THIS FILE IS GITIGNORED. Template: agora_credentials.h.example
//
// How to get these:
//   1. Go to https://console.agora.io
//   2. Create a project (or use existing), note the App ID
//   3. Under "RESTful API", create an API Key + Secret pair
//   4. Enable "Conversational AI" service in the project settings
//   5. Fill in the values below

// -- Agora RTC --
#define AGORA_APP_ID        "YOUR_AGORA_PRO_DEV_APP_ID"
#define AGORA_RTC_TOKEN     ""          // optional -- leave empty for testing

// -- Agora RESTful API (for creating/destroying AI agents) --
#define AGORA_API_KEY       "YOUR_AGORA_REST_API_KEY"
#define AGORA_API_SECRET    "YOUR_AGORA_REST_API_SECRET"

// -- AI Agent Config --
// LLM backend (used in app_config.h JSON sent to /join)
#define STACKCHAN_LLM_URL        "https://api.openai.com/v1/chat/completions"
#define STACKCHAN_LLM_API_KEY    "YOUR_OPENAI_OR_LLM_API_KEY"
#define STACKCHAN_LLM_MODEL      "gpt-4o-mini"

// TTS backend
#define STACKCHAN_TTS_VENDOR     "elevenlabs"
#define STACKCHAN_TTS_KEY        "YOUR_TTS_API_KEY"
#define STACKCHAN_TTS_VOICE      "en-US-Jenny"

// Agent channel name (base name; actual channel will be randomized at runtime)
#define STACKCHAN_CHANNEL_NAME   "stackchan_dev"

// Voice codec: "PCMU" (G.711, 8kHz) or "G722" (16kHz)
#define STACKCHAN_AUDIO_CODEC    "G722"

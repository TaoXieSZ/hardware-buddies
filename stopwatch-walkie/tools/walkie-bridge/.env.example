DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
WALKIE_BRIDGE_HOST=127.0.0.1
WALKIE_BRIDGE_PORT=8765
# Read-only local dashboard; the host is always fixed to IPv4 loopback.
WALKIE_DASHBOARD_ENABLED=1
WALKIE_DASHBOARD_PORT=8766
WALKIE_BRIDGE_ASR_TIMEOUT=30
WALKIE_TTS_VOICE=Tingting
WALKIE_TTS_TIMEOUT=30
# Control mode is opt-in. Generate a 32-byte secret with:
# python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode())'
WALKIE_CONTROL_ENABLED=0
WALKIE_CONTROL_SECRET=
WALKIE_CONTROL_ALIASES_JSON={"小表 codex":{"agent":"codex","project_label":"hardware-buddies"}}
WALKIE_PROPOSAL_TTL=60
WALKIE_CC_BRIDGE_SOCKET=/tmp/cc-bridge.sock

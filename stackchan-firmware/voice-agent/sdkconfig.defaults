# StackChan Voice Agent — CoreS3 (ESP32-S3, 16MB QIO flash, 8MB Octal PSRAM)

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM — CoreS3 (ESP32-S3R8) has in-package OCTAL PSRAM; Arduino core uses
# qio_opi for this board. QUAD mode boot-loops on-device ("quad_psram: PSRAM
# ID read error: 0x00ffffff", observed 2026-08-02). An earlier note here
# claimed the opposite (quad, verified 2026-07-08) — that note was wrong.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# FreeRTOS 1000Hz tick — Agora RTC SDK requirement (audio pacing)
CONFIG_FREERTOS_HZ=1000

# Bigger main task stack: Wi-Fi + Agora init runs on it
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Partition table (file lives in this directory)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="default_16MB.csv"
